# Copy this file to backend/.env for local backend development.
# Keep real credentials in .env files or a secret manager; never commit them.
APP_NAME=Sunday Table API
API_PREFIX=/api/v1

# Local PostgreSQL. The app can use its SQLite demo fallback if PostgreSQL is
# unavailable while ALLOW_SQLITE_FALLBACK is true.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/food_ordering
REDIS_URL=redis://localhost:6379/0

# Replace this example with a randomly generated secret before any deployment.
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
ALLOW_SQLITE_FALLBACK=true
REQUIRE_REDIS=false

# Optional; set a private token if exposing /metrics.
METRICS_AUTH_TOKEN=
DELIVERY_SPEED_KMH=20
PREP_BUFFER_MINUTES=12
